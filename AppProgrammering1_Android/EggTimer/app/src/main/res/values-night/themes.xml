<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EggTimer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/Pantone</item>
        <item name="colorPrimaryVariant">@color/Flavescent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorAccent">?attr/colorPrimaryVariant</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/LightGoldenrodYellow</item>
        <item name="colorSecondaryVariant">@color/LightGoldenrodYellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="backgroundColor">@color/darkBackground</item>
    </style>
</resources>