<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ValutaConverterApp.Views.HomePage"
             xmlns:vm="clr-namespace:ValutaConverterApp.ViewModels"
             
             Title="{Binding Title}">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>


    <ContentPage.Content>
        <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="Fill">
            <Label Text="Find valuta ids in currency tab"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackLayout Grid.Column="0" Grid.Row="0" HorizontalOptions="FillAndExpand">
                    <Entry x:Name="FromValuta_Entry" Placeholder="USD" Text="{Binding FromValuta, Mode=TwoWay}" MaxLength="3" Unfocused="ValutaEntry_Unfocused" HorizontalOptions="CenterAndExpand" />
                    <Entry  x:Name="FromAmount_Entry" Placeholder="1" Text="{Binding FromAmount, StringFormat='{0:N2}', Mode=TwoWay}" Keyboard="Numeric"  Unfocused="FromAmount_Entry_Unfocused" MinimumWidthRequest="50" HorizontalOptions="FillAndExpand" />
                </StackLayout>
                <StackLayout Grid.Column="2" Grid.Row="0" HorizontalOptions="FillAndExpand">
                    <Entry x:Name="ToValuta_Entry" Placeholder="DKK" Text="{Binding ToValuta, Mode=TwoWay}" MaxLength="3" Unfocused="ValutaEntry_Unfocused" HorizontalOptions="CenterAndExpand"  />
                    <Entry x:Name="ToAmount_Entry" Placeholder="0" Text="{Binding ToAmount, StringFormat='{0:N2}', Mode=TwoWay}" Keyboard="Numeric" Unfocused="ToAmount_Entry_Unfocused" MinimumWidthRequest="50" HorizontalOptions="FillAndExpand"/>
                    
                </StackLayout>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
